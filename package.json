{
  "name": "stuti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stuti: free, offline-first digital hymnal for Indian churches",
  "license": "MIT",
  "scripts": {
    "dev": "npm run indexes && astro dev",
    "validate": "tsx --env-file-if-exists=.env scripts/validate.ts",
    "indexes": "tsx --env-file-if-exists=.env scripts/build-indexes.ts",
    "new-song": "tsx --env-file-if-exists=.env scripts/new-song.ts",
    "prebuild": "npm run validate && npm run indexes",
    "build": "astro build",
    "postbuild": "tsx scripts/font-manifest.ts",
    "check-precache": "tsx scripts/check-precache.ts",
    "check-budgets": "tsx scripts/check-budgets.ts",
    "check-safety": "tsx scripts/check-safety.ts",
    "check": "astro check",
    "lhci": "lhci autorun",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier -w .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/domine": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "astro": "^5.18.2",
    "minisearch": "^7.2.0",
    "pptxgenjs": "^4.0.1",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/astro": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.165.0"
  }
}
