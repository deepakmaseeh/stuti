---
import AppShell from '../components/AppShell.astro';
import { site } from '../site.config';
import { t } from '../i18n';
---

<AppShell
  title={`${site.name} · ${site.tagline}`}
  description="Free, offline Christian hymnal in Hindi, Tamil, Telugu, Punjabi and English, numbered like the printed book."
  active="home"
>
  <div class="placeholder">
    <h1 class="page-title">{site.name}</h1>
    <p class="names">
      <span lang="hi">स्तुति</span> · <span lang="ta">துதி</span> · <span lang="te">స్తుతి</span> ·
      <span lang="pa">ਉਸਤਤ</span>
    </p>
    <p class="muted">{site.tagline}</p>
    <p>
      <a href="/books/">{t('books.title')}</a>
    </p>
  </div>
</AppShell>

<style>
  .placeholder {
    display: grid;
    gap: var(--s3);
    text-align: center;
    padding-top: var(--s12);
  }
  .names {
    font-size: var(--text-lg);
  }
</style>
