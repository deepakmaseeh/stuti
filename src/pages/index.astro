---
import AppShell from '../components/AppShell.astro';
import NumberBadge from '../components/NumberBadge.astro';
import HomeLists from '../components/islands/HomeLists';
import FirstVisitTour from '../components/islands/FirstVisitTour';
import InstallPrompt from '../components/islands/InstallPrompt';
import { getBookEntries, getBooks } from '../lib/content';
import { LANG_LABEL, LANG_TAG } from '../lib/scripts';
import { site } from '../site.config';
import { t } from '../i18n';

const books = await Promise.all(
  (await getBooks()).map(async (b) => ({ book: b, count: (await getBookEntries(b.id)).length })),
);
---

<AppShell
  title={`${site.name} · ${site.tagline}`}
  description="Free, offline Christian hymnal in Hindi, Tamil, Telugu, Punjabi and English, numbered like the printed book."
  active="home"
>
  <h1 class="visually-hidden">{site.name}</h1>

  {/* Home = This Sunday + Your songs + Hymnbooks only (FINAL_UI_SPEC §5). No search chips/tips. */}
  <HomeLists client:load />
  <FirstVisitTour client:idle />
  <InstallPrompt client:idle />

  <section class="home-books" aria-labelledby="books-title">
    <div class="home-books__head">
      <h2 class="group-title" id="books-title">
        {t('home.books')}
      </h2>
      <a class="home-books__offline" href="/downloads/" data-feature="offline">{t('nav.offline')}</a>
    </div>
    <div class="home-books__grid">
      {books.map(({ book, count }) => (
        <a class="book-card" href={`/books/${book.id.toLowerCase()}/`}>
          <NumberBadge
            book={book.lang === 'en' ? 'ENGLISH' : book.lang === 'hi' ? 'HINDI' : LANG_LABEL[book.lang].toUpperCase()}
            number={book.id}
          />
          <span class="book-card__text">
            <span class="book-card__title" lang={LANG_TAG.n[book.lang]}>
              {book.name.native}
              {book.name.en && book.name.en !== book.name.native ? ` · ${book.name.en}` : ''}
            </span>
            <span class="book-card__sub">
              {LANG_LABEL[book.lang]} · {t('books.count', { n: count })}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
</AppShell>
