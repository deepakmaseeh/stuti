---
import AppShell from '../../components/AppShell.astro';
import { site } from '../../site.config';
import { t } from '../../i18n';
---

<AppShell title={`${t('noConn.title')} | ${site.name}`} noindex>
  <div class="empty no-conn">
    <svg viewBox="0 0 24 24" width="48" height="48" aria-hidden="true" class="no-conn__icon">
      <path d="M2 8.8a15 15 0 0 1 20 0M5 12.6a10 10 0 0 1 14 0M8.5 16.4a5 5 0 0 1 7 0M12 20h.01M3 3l18 18"></path>
    </svg>
    <h1 class="page-title">{t('noConn.title')}</h1>
    <p>{t('noConn.body')}</p>
    <a class="btn btn--primary" href="/downloads/">
      {t('noConn.downloads')}
    </a>
    <a class="btn btn--secondary" href="/search/?tab=songs">
      {t('noConn.search')}
    </a>
    <p class="muted">{t('noConn.tip')}</p>
  </div>
</AppShell>
