---
import AppShell from '../components/AppShell.astro';
import { site } from '../site.config';
import { t } from '../i18n';
---

<AppShell title={`${t('notFound.title')} | ${site.name}`} noindex>
  <h1 class="page-title">{t('notFound.title')}</h1>
  <p>{t('notFound.body')}</p>
  <!-- Plain GET form: works without JS and lands on the Words tab via ?q= -->
  <form class="notfound-search" action="/search/" method="get" role="search">
    <label for="nf-q" class="field__label">
      {t('notFound.searchHint')}
    </label>
    <div class="notfound-search__row">
      <input
        id="nf-q"
        class="search-input"
        type="search"
        name="q"
        placeholder={t('search.placeholder')}
        enterkeyhint="search"
      />
      <button type="submit" class="btn btn--primary">
        {t('notFound.go')}
      </button>
    </div>
  </form>
  <p>
    <a href={site.report.missingSongUrl} rel="noopener" target="_blank">
      {t('search.reportMissing')}
    </a>
    · <a href="/books/">{t('books.title')}</a>
  </p>
</AppShell>
