---
/**
 * CMS shell for `astro dev` and the static build.
 * Scripts must be `is:inline` so Astro/Vite do not rewrite them into broken modules.
 * `public/admin/index.html` stays as the plain static copy for hosts that serve public/ as-is.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Stuti Admin</title>
  </head>
  <body>
    <!-- Exact version on purpose (no ranges). Bump deliberately and re-test /admin/. -->
    <script is:inline src="https://unpkg.com/decap-cms@3.18.0/dist/decap-cms.js"></script>
    <script is:inline src="/admin/preview.js"></script>
  </body>
</html>
