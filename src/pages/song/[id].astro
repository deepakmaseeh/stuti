---
import AppShell from '../../components/AppShell.astro';
import NumberBadge from '../../components/NumberBadge.astro';
import OfflineBadge from '../../components/OfflineBadge.astro';
import LyricSection from '../../components/LyricSection.astro';
import SongMeta from '../../components/SongMeta.astro';
import SongToolbar from '../../components/islands/SongToolbar.tsx';
import FavStar from '../../components/islands/FavStar.tsx';
import MobileSearchMenu from '../../components/islands/MobileSearchMenu';
import ReportSheet from '../../components/islands/ReportSheet.tsx';
import SetNavBar from '../../components/islands/SetNavBar.tsx';
import { reportUrl } from '../../lib/report';
import { getSongs } from '../../lib/content';
import { safeJsonLd } from '../../lib/jsonld';
import { LANG_NATIVE, LANG_TAG } from '../../lib/scripts';
import type { Song } from '../../lib/schema';
import { shouldShowChorusMarker } from '../../lib/chorus';
import { badgeText, primaryNumber, songUrl } from '../../lib/songs';
import { site } from '../../site.config';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map((song) => ({ params: { id: song.id }, props: { song } }));
}

const { song } = Astro.props as { song: Song };
const isEn = song.lang === 'en';
const showR = !isEn && song.layers.roman !== 'missing';
const showE = !isEn && song.layers.en !== 'missing';
const primary = primaryNumber(song);
const url = songUrl(song.id);
const lines = song.sections.flatMap((s) => s.lines);

const titleTag = isEn
  ? `${song.title.native} hymn lyrics | ${site.name}`
  : `${[`${song.title.native} lyrics`, song.title.roman, song.title.en].filter(Boolean).join(' · ')} | ${site.name}`;
const description = lines
  .slice(0, 2)
  .map((l) => [l.n, isEn ? '' : l.r].filter(Boolean).join(' / '))
  .join(' · ');
const subtitle = [song.title.roman, song.title.en].filter(Boolean).join(' · ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: song.title.native,
  alternateName: [song.title.roman, song.title.en].filter(Boolean),
  inLanguage: song.lang,
  lyricist: { '@type': 'Person', name: song.author.name },
  lyrics: { '@type': 'CreativeWork', text: (song.sections[0]?.lines ?? []).map((l) => l.n).join('\n') },
  url: new URL(url, site.url).href,
};

const snapshot = { id: song.id, title: song.title.native, lang: song.lang, badge: badgeText(primary) };
const numbersData = JSON.stringify(song.numbers);
---

<AppShell
  title={titleTag}
  description={description}
  canonicalPath={url}
  currentSongId={song.id}
  hideMobileHeader
>
  <script slot="head" type="application/ld+json" set:html={safeJsonLd(jsonLd)} />

  <header class="song-header">
    <div class="app-column song-header__inner">
      <a class="icon-btn" href={`/books/${primary.book.toLowerCase()}/`} aria-label={t('song.back')} data-back>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="m15 5-7 7 7 7"></path>
        </svg>
      </a>
      <span data-numbers={numbersData} class="song-header__badge">
        <NumberBadge book={primary.book} number={primary.number} size="header" />
      </span>
      <span class="song-header__end">
        <span class="song-header__search">
          <MobileSearchMenu client:load />
        </span>
        <OfflineBadge />
        <FavStar client:load snapshot={snapshot} />
        <a class="btn btn--primary song-present" href={`/present/?song=${song.id}`}>
          {t('desktop.present')}
        </a>
      </span>
    </div>
  </header>
  <script is:inline>
    (function () {
      const from = new URLSearchParams(location.search).get('from');
      const wrap = document.querySelector('[data-numbers]');
      if (from && wrap) {
        const hit = JSON.parse(wrap.getAttribute('data-numbers')).find(function (n) {
          return n.book.toLowerCase() === from.toLowerCase();
        });
        if (hit) {
          wrap.querySelector('.badge').setAttribute('aria-label', hit.book + ' ' + hit.number);
          wrap.querySelector('.badge__book').textContent = hit.book;
          wrap.querySelector('.badge__num').textContent = hit.number;
        }
      }
      const back = document.querySelector('[data-back]');
      if (back && document.referrer.indexOf(location.origin) === 0 && history.length > 1) {
        back.addEventListener('click', function (e) {
          e.preventDefault();
          history.back();
        });
      }
    })();
  </script>

  <div class="song">
    <h1 class="song__title" lang={LANG_TAG.n[song.lang]}>
      {song.title.native}
    </h1>
    {
      subtitle && (
        <p class="song__subtitle" lang="en">
          {subtitle}
        </p>
      )
    }

    <SongToolbar
      client:load
      snapshot={snapshot}
      isEnglish={isEn}
      nativeLabel={LANG_NATIVE[song.lang]}
      nativeLang={LANG_TAG.n[song.lang]}
      layers={{ r: isEn ? 'missing' : song.layers.roman, e: isEn ? 'missing' : song.layers.en }}
      share={{ title: song.title.native, text: lines[0]?.n ?? '', url }}
      books={song.numbers.map((n) => n.book)}
    />

    <div class:list={['lyrics', { 'is-en': isEn, 'has-r': showR, 'has-e': showE }]}>
      {
        !isEn && (showR || showE) && (
          <div class="lyrics-cols" aria-hidden="true">
            <span>{LANG_NATIVE[song.lang]}</span>
            {showR && <span>{t('song.roman')}</span>}
            {showE && <span>{t('song.english')}</span>}
          </div>
        )
      }
      {
        song.sections.map((section, index) => (
          <LyricSection
            section={section}
            lang={song.lang}
            showRoman={showR}
            showEnglish={showE}
            chorusMarker={shouldShowChorusMarker(song.sections, index, !!song.display.chorusAfterEachVerse)}
          />
        ))
      }
    </div>

    <SongMeta song={song} />

    <ReportSheet
      client:idle
      songId={song.id}
      title={song.title.native}
      fallbackHref={reportUrl({
        songId: song.id,
        title: song.title.native,
        line: '',
        correction: '',
        pageUrl: new URL(url, site.url).href,
      })}
    />
    <p class="print-footer">
      {site.url.replace(/^https?:\/\//, '')} · {badgeText(primary)}
    </p>
  </div>
  <SetNavBar client:load />
</AppShell>
