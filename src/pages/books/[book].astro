---
import AppShell from '../../components/AppShell.astro';
import SongRow from '../../components/SongRow.astro';
import BookDownloadButton from '../../components/islands/BookDownloadButton';
import { getBookEntries, getBooks } from '../../lib/content';
import { LANG_LABEL, LANG_TAG } from '../../lib/scripts';
import type { Book } from '../../lib/schema';
import { songUrl } from '../../lib/songs';
import { site } from '../../site.config';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({ params: { book: book.id.toLowerCase() }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
const entries = await getBookEntries(book.id);
---

<AppShell
  title={`${book.name.en} (${book.id}) | ${site.name}`}
  description={`${book.name.native} · ${book.name.en}: ${t('books.count', { n: entries.length })}, numbered like the printed book.`}
  active="home"
>
  <a class="link-v3" href="/" style="margin-bottom: 6px;">
    ← Home
  </a>
  <h1 class="page-title" lang={LANG_TAG.n[book.lang]}>
    {book.name.native}
  </h1>
  <p class="page-sub">
    {LANG_LABEL[book.lang]} · {t('books.count', { n: entries.length })} · in hymn-number order
  </p>
  <BookDownloadButton client:idle bookId={book.id} lang={book.lang} />

  <div class="book-list">
    {
      entries.map(({ number, song }) => (
        <div id={`n-${number}`}>
          <SongRow
            href={`${songUrl(song.id)}?from=${book.id.toLowerCase()}`}
            book={book.id}
            number={number}
            title={song.title.native}
            subtitle={song.title.roman || undefined}
            lang={song.lang}
          />
        </div>
      ))
    }
  </div>
</AppShell>

<style>
  .book-jump {
    position: sticky;
    top: 56px;
    z-index: 2;
    padding: 8px 0;
    margin: 8px 0 12px;
    background: color-mix(in oklab, var(--page) 92%, transparent);
    backdrop-filter: blur(6px);
    gap: 6px;
  }
  .book-jump .chip {
    flex: 0 0 auto;
    min-width: 44px;
    justify-content: center;
  }
</style>
