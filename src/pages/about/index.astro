---
import AppShell from '../../components/AppShell.astro';
import { getBooks } from '../../lib/content';
import { LANG_LABEL, LANG_TAG } from '../../lib/scripts';
import { appVersion, contentVersion } from '../../lib/version';
import { site } from '../../site.config';
import { t } from '../../i18n';

const books = await getBooks();
---

<AppShell
  title={`${t('about.title')} | ${site.name}`}
  description="Why Stuti exists, which songs it publishes, and how to contact the editors."
>
  <article class="prose">
    <h1 class="page-title">{t('about.title')}</h1>
    <p>
      Stuti is a free hymnal for Indian churches. It shows each song in its own script, in Roman letters and
      with an English meaning, numbered exactly like the printed hymnbook, and it keeps working in church with
      no signal once a book is downloaded.
    </p>
    <p>No ads. No login. No tracking.</p>

    <h2>{t('about.howTitle')}</h2>
    <ol>
      <li>{t('about.howFind')}</li>
      <li>{t('about.howFav')}</li>
      <li>{t('about.howSet')}</li>
      <li>{t('about.howOffline')}</li>
    </ol>

    <h2>Which songs we publish</h2>
    <ul>
      <li>
        <strong>Public domain:</strong> the author died more than 60 years ago (Indian copyright law), or the
        song is traditional and old enough, with evidence.
      </li>
      <li>
        <strong>Licensed:</strong> we have written permission from the author, their family or the publisher,
        covering this app, offline use, transliteration and translation.
      </li>
      <li>
        Every other song stays unpublished until its rights are checked. Translations and transliterations of
        a protected song need permission too.
      </li>
    </ul>
    {site.includeDemo && (
      <p class="notice">This build includes demo texts written for testing. They are not real hymns.</p>
    )}

    <h2>Hymnbooks</h2>
    <ul>
      {books.map((b) => (
        <li>
          <a href={`/books/${b.id.toLowerCase()}/`} lang={LANG_TAG.n[b.lang]}>
            {b.name.native}
          </a>{' '}
          · {b.name.en} ({LANG_LABEL[b.lang]}){b.publisher && <> · {b.publisher}</>}
          {b.edition && <> · {b.edition}</>}
        </li>
      ))}
    </ul>

    <h2>Mistakes and takedown requests</h2>
    <p>
      Use “{t('song.report')}” at the bottom of any song. Editors check every report before changing a song.
      {site.contactEmail ? (
        <>
          If you hold the rights to a song and want it removed, write to{' '}
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>. We act within 48 hours.
        </>
      ) : (
        <>
          If you hold the rights to a song and want it removed, use the same report button and we act within
          48 hours.
        </>
      )}
    </p>

    <h2>Presentations</h2>
    <p>
      Song and set exports create PowerPoint files in your browser. On Windows, Indian scripts use Nirmala UI.
      {t('desktop.pptMacNote')}
    </p>

    <h2>Privacy</h2>
    <p>
      Stuti sets no cookies and collects no personal data. Your favourites, sets and settings stay on your
      phone. Mistake reports stay on your device until they can sync to the church corrections sheet.
    </p>

    <h2 id="built">Who built this</h2>
    <p>
      {site.name} was built by <strong>{site.maker.name}</strong>.
    </p>
    <a class="maker-preview" href={site.maker.url} rel="noopener noreferrer" target="_blank">
      <span class="maker-preview__chrome" aria-hidden="true">
        <span class="maker-preview__dot"></span>
        <span class="maker-preview__dot"></span>
        <span class="maker-preview__dot"></span>
        <span class="maker-preview__url">{site.maker.host}</span>
      </span>
      <span class="maker-preview__body">
        <span class="maker-preview__name">{site.maker.name}</span>
        <span class="maker-preview__blurb">{site.maker.blurb}</span>
        <span class="maker-preview__cta">Visit website →</span>
      </span>
    </a>

    <h2 id="contact">Contact</h2>
    <ul class="maker-contact">
      <li>
        <strong>Email</strong>
        <a href={`mailto:${site.maker.email}`}>{site.maker.email}</a>
      </li>
      <li>
        <strong>Phone</strong>
        {
          site.maker.phones.map((tel, i) => (
            <>
              {i > 0 ? ' · ' : ''}
              <a href={`tel:${tel}`}>{site.maker.phoneLabels[i]}</a>
            </>
          ))
        }
      </li>
      <li>
        <strong>Address</strong>
        {site.maker.address}
      </li>
      <li>
        <strong>Google</strong>
        <a href={site.maker.mapsUrl} rel="noopener noreferrer" target="_blank">Open on Google Maps</a>
      </li>
    </ul>

    <p>
      <a class="btn btn--secondary" href="/guide/#guide">Read the user guide →</a>
    </p>

    <p class="muted">
      Version {appVersion} · content {contentVersion}
    </p>
  </article>
</AppShell>

<style>
  .maker-preview {
    display: block;
    margin: 1rem 0 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--page);
    box-shadow: 0 8px 24px color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .maker-preview__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--leather);
    color: var(--gold-soft);
  }
  .maker-preview__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--gold) 55%, transparent);
  }
  .maker-preview__url {
    margin-left: 8px;
    font: 600 12px/1 var(--font-ui);
    letter-spacing: 0.02em;
    opacity: 0.9;
  }
  .maker-preview__body {
    display: grid;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .maker-preview__name {
    font: 700 1.15rem/1.3 var(--font-display);
  }
  .maker-preview__blurb {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .maker-preview__cta {
    margin-top: 4px;
    font: 600 0.9rem/1.2 var(--font-ui);
    color: var(--gold-ink);
  }
  .maker-contact {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.25rem;
    display: grid;
    gap: 10px;
  }
  .maker-contact li {
    display: grid;
    gap: 2px;
  }
  .maker-contact strong {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
