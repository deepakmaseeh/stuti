---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/desktop.css';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  /** Path for <link rel="canonical"> (defaults to the current path). */
  canonicalPath?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description = site.tagline, canonicalPath, noindex = false, bodyClass } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
// Optional cookieless Cloudflare Web Analytics: nothing is loaded unless the token is set at build time.
const analyticsToken = /^[a-f0-9]{32}$/i.test(site.analyticsToken) ? site.analyticsToken : '';
---

<!doctype html>
<html lang="en" data-theme="system" data-size="2">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#4a1820" />
    <ClientRouter />
    <script is:inline define:vars={{ desktopMin: site.layout.desktopMin, wideMin: site.layout.wideMin }}>
      document.documentElement.classList.add('js');
      // Before paint: desktop panes vs mobile (STUTI_DESKTOP_ADDON.md).
      (function () {
        var w = window.innerWidth;
        var h = document.documentElement;
        if (w >= desktopMin) h.setAttribute('data-desktop', w >= wideMin ? 'wide' : 'split');
        else h.removeAttribute('data-desktop');
      })();
      try {
        const p = JSON.parse(localStorage.getItem('stuti:prefs') || '{}');
        const l = p.layers || { n: true, r: true, e: false };
        const h = document.documentElement;
        h.dataset.layers = ['n', 'r', 'e'].filter((k) => l[k]).join(' ') || 'n';
        // Desktop default lyric size is one step larger (index 3).
        var sizeDefault = h.dataset.desktop ? 3 : 2;
        h.dataset.size = String(p.size == null ? sizeDefault : p.size);
        h.dataset.theme = p.theme || 'system';
        h.dataset.layout = p.layout === 'columns' ? 'columns' : h.dataset.desktop === 'wide' ? 'columns' : 'stacked';
      } catch {
        // Storage blocked or corrupt: keep the server defaults.
      }
      // Chrome fires this early; keep it for InstallPrompt, which decides when (and if) to offer it.
      addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        self.__stutiInstall = e;
        dispatchEvent(new Event('stuti:installable'));
      });
      addEventListener('resize', function () {
        var w = window.innerWidth;
        var h = document.documentElement;
        if (w >= desktopMin) h.setAttribute('data-desktop', w >= wideMin ? 'wide' : 'split');
        else h.removeAttribute('data-desktop');
      });
    </script>
    <slot name="head" />
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import { registerServiceWorker } from '../lib/pwa';
      // No service worker in `astro dev` (devOptions.enabled is false).
      if (import.meta.env.PROD) registerServiceWorker();
    </script>
  </body>
</html>
