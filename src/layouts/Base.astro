---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/ui-v14.css';
import '../styles/desktop.css';
import '../styles/v3/tokens.css';
import '../styles/v3/app.css';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description = site.tagline, canonicalPath, noindex = false, bodyClass } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const analyticsToken = /^[a-f0-9]{32}$/i.test(site.analyticsToken) ? site.analyticsToken : '';
---

<!doctype html>
<html lang="en" data-theme="system" data-scheme="light" data-size="2">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#4a1820" />
    <ClientRouter />
    {/* Theme must be re-applied on every view-transition swap (FINAL_UI_SPEC §3). */}
    <script is:inline define:vars={{ desktopMin: site.layout.desktopMin, wideMin: site.layout.wideMin }}>
      (() => {
        const KEY = 'stuti:prefs';
        const TC = { light: '#4a1820', dark: '#1a0f11' };
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const read = () => {
          try {
            return JSON.parse(localStorage.getItem(KEY) || '{}');
          } catch {
            return {};
          }
        };
        const desk = (root) => {
          const w = innerWidth;
          if (w >= desktopMin) root.dataset.desktop = w >= wideMin ? 'wide' : 'split';
          else delete root.dataset.desktop;
        };
        const apply = (root = document.documentElement) => {
          const p = read();
          let chosen = p.theme || 'system';
          if (chosen === 'contrast') chosen = 'dark';
          const scheme =
            chosen === 'system' ? (mq.matches ? 'dark' : 'light') : chosen === 'dark' ? 'dark' : 'light';
          desk(root);
          root.dataset.theme = chosen;
          root.dataset.scheme = scheme;
          root.style.colorScheme = scheme === 'light' ? 'light' : 'dark';
          const l = p.layers || { n: true, r: true, e: false };
          root.dataset.layers = ['n', 'r', 'e'].filter((k) => l[k]).join(' ') || 'n';
          root.dataset.size = String(p.size ?? (root.dataset.desktop ? 3 : 2));
          root.dataset.layout =
            p.layout === 'columns' || root.dataset.desktop === 'wide' ? 'columns' : 'stacked';
          const m = root.ownerDocument.querySelector('meta[name="theme-color"]');
          if (m) m.content = TC[scheme] || TC.light;
          root.classList.add('js');
        };
        apply();
        if (!window.__stutiPrefsBound) {
          window.__stutiPrefsBound = true;
          document.addEventListener('astro:before-swap', (e) => {
            apply(e.newDocument.documentElement);
          });
          document.addEventListener('astro:after-swap', () => apply());
          document.addEventListener('astro:page-load', () => apply());
          addEventListener('storage', (e) => {
            if (e.key === KEY) apply();
          });
          addEventListener('stuti:prefs', () => apply());
          mq.addEventListener('change', () => apply());
          addEventListener('resize', () => apply());
          addEventListener('pageshow', (e) => {
            if (e.persisted) apply();
          });
        }
      })();
    </script>
    <script is:inline>
      addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        self.__stutiInstall = e;
        dispatchEvent(new Event('stuti:installable'));
      });
    </script>
    <slot name="head" />
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body class={['v3', bodyClass].filter(Boolean).join(' ')}>
    <slot />
    <script>
      import { registerServiceWorker } from '../lib/pwa';
      if (import.meta.env.PROD) registerServiceWorker();
    </script>
  </body>
</html>
