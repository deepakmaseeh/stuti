---
import TopBarActions from './islands/TopBarActions';
import ThemeToggle from './islands/ThemeToggle';
import { site } from '../site.config';
import { t } from '../i18n';
---

<header class="topbar" transition:persist="topbar">
  <a class="topbar__brand" href="/">
    <span class="topbar__name">{site.name}</span>
    <span class="topbar__tag">{t('desktop.tagline')}</span>
  </a>
  <nav class="topbar__nav" aria-label="Desktop">
    <a class="topbar__nav-link" href="/">{t('nav.home')}</a>
    <a class="topbar__nav-link" href="/sets/">{t('nav.sets')}</a>
    <a class="topbar__nav-link" href="/downloads/" data-feature="offline">{t('nav.offline')}</a>
    <details class="topbar__more menu">
      <summary class="topbar__nav-link" aria-label={t('home.menu')} data-feature="settings">⋯</summary>
      <div class="menu__list">
        <a href="/settings/" data-feature="settings">{t('home.settings')}</a>
        <a href="/about/">{t('home.about')}</a>
      </div>
    </details>
  </nav>
  <div class="topbar__acts-inline">
    <ThemeToggle client:media={`(min-width: ${site.layout.desktopMin}px)`} compact />
    <TopBarActions client:media={`(min-width: ${site.layout.desktopMin}px)`} />
  </div>
</header>
<script is:inline>
  (function () {
    var path = location.pathname;
    document.querySelectorAll('.topbar__nav-link[href]').forEach(function (a) {
      var href = a.getAttribute('href') || '';
      if (href === '/' ? path === '/' : path.indexOf(href) === 0) a.setAttribute('aria-current', 'page');
    });
  })();
</script>
