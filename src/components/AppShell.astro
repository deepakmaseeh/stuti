---
import Base from '../layouts/Base.astro';
import BottomNav from './BottomNav.astro';
import OfflineBadge from './OfflineBadge.astro';
import TopBar from './TopBar.astro';
import Finder from './islands/Finder';
import SetPanel from './islands/SetPanel';
import KeyboardShortcuts from './islands/KeyboardShortcuts';
import type { BookChip } from './islands/Keypad';
import { getBooks } from '../lib/content';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  heading?: string;
  active?: 'home' | 'search' | 'set' | 'offline';
  /** Highlight this song in Finder / Set panel. */
  currentSongId?: string;
  /** Hide the mobile-only page header (song pages have their own). */
  hideMobileHeader?: boolean;
}
const {
  title,
  description,
  canonicalPath,
  noindex,
  heading = site.name,
  active,
  currentSongId = '',
  hideMobileHeader = false,
} = Astro.props;

const books: BookChip[] = (await getBooks()).map((b) => ({
  id: b.id,
  native: b.name.native,
  en: b.name.en,
  lang: b.lang,
  numbering: b.numbering,
}));
---

<Base title={title} description={description} canonicalPath={canonicalPath} noindex={noindex}>
  <slot name="head" slot="head" />
  <TopBar />
  <div class="desktop-shell">
    <aside class="desktop-finder" transition:persist="finder">
      {/* client:only: not in mobile SSR DOM (avoids duplicate keypads with /search/). */}
      <Finder client:media="(min-width: 900px)" books={books} currentId={currentSongId} />
    </aside>
    <div class="desktop-main" transition:animate="fade">
      {
        !hideMobileHeader && (
          <header class="app-header">
            <div class="app-column app-header__inner">
              <a href="/" class="app-header__name">
                {heading}
              </a>
              <div class="app-header__actions">
                <OfflineBadge />
                <slot name="actions" />
              </div>
            </div>
          </header>
        )
      }
      <main id="main" class="app-column app-main app-main-inner">
        <slot />
      </main>
    </div>
    <div
      class="desktop-set-drawer-backdrop"
      data-close-drawer
      onclick="this.classList.remove('is-open');document.querySelector('.desktop-set')?.classList.remove('is-open')"
    >
    </div>
    <aside class="desktop-set is-drawer" transition:persist="setpanel">
      <SetPanel client:media="(min-width: 900px)" currentId={currentSongId} />
    </aside>
  </div>
  <BottomNav active={active} />
  <KeyboardShortcuts client:media="(min-width: 900px)" />
</Base>
