---
import Base from '../layouts/Base.astro';
import BottomNav from './BottomNav.astro';
import TopBar from './TopBar.astro';
import Finder from './islands/Finder';
import SetPanel from './islands/SetPanel';
import KeyboardShortcuts from './islands/KeyboardShortcuts';
import ThemeToggle from './islands/ThemeToggle';
import type { BookChip } from './islands/Keypad';
import { getBooks } from '../lib/content';
import { site } from '../site.config';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  heading?: string;
  active?: 'home' | 'search' | 'set' | 'sets' | 'offline';
  currentSongId?: string;
  hideMobileHeader?: boolean;
  bodyClass?: string;
  hideBottomNav?: boolean;
}
const {
  title,
  description,
  canonicalPath,
  noindex,
  heading = site.name,
  active,
  currentSongId = '',
  hideMobileHeader = false,
  bodyClass,
  hideBottomNav = false,
} = Astro.props;

const books: BookChip[] = (await getBooks()).map((b) => ({
  id: b.id,
  native: b.name.native,
  en: b.name.en,
  lang: b.lang,
  numbering: b.numbering,
}));
---

<Base
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  bodyClass={[bodyClass, hideBottomNav ? 'hide-bottom-nav' : ''].filter(Boolean).join(' ') || undefined}
>
  <slot name="head" slot="head" />
  <TopBar />
  <div class="desktop-shell">
    <aside class="desktop-finder" transition:persist="finder">
      <Finder client:media={`(min-width: ${site.layout.desktopMin}px)`} books={books} currentId={currentSongId} />
    </aside>
    <div class="desktop-main" transition:animate="none">
      {
        !hideMobileHeader && (
          <header class="app-header">
            <div class="app-column app-header__inner">
              <a href="/" class="app-header__name">
                {heading}
              </a>
              <div class="app-header__actions">
                <ThemeToggle client:load compact />
                <details class="menu">
                  <summary class="icon-btn" aria-label={t('home.menu')} data-feature="settings">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                      <path d="M12 5h.01M12 12h.01M12 19h.01" stroke-width="3"></path>
                    </svg>
                  </summary>
                  <div class="menu__list">
                    <a href="/settings/" data-feature="settings">{t('home.settings')}</a>
                    <a href="/about/">{t('home.about')}</a>
                    <slot name="menu-extra" />
                  </div>
                </details>
                <slot name="actions" />
              </div>
            </div>
          </header>
        )
      }
      <main id="main" class="app-column app-main app-main-inner">
        <slot />
      </main>
    </div>
    <div
      class="desktop-set-drawer-backdrop"
      data-close-drawer
      onclick="this.classList.remove('is-open');document.querySelector('.desktop-set')?.classList.remove('is-open')"
    >
    </div>
    <aside class="desktop-set is-drawer" transition:persist="setpanel">
      <SetPanel client:media={`(min-width: ${site.layout.desktopMin}px)`} currentId={currentSongId} />
    </aside>
  </div>
  {!hideBottomNav && <BottomNav active={active} />}
  <KeyboardShortcuts client:media={`(min-width: ${site.layout.desktopMin}px)`} />
</Base>
