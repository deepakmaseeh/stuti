---
import Base from '../layouts/Base.astro';
import BottomNav from './BottomNav.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  /** Heading shown in the header (defaults to the app name). */
  heading?: string;
  active?: 'home' | 'search' | 'set' | 'offline';
}
const { title, description, canonicalPath, noindex, heading = site.name, active } = Astro.props;
---

<Base title={title} description={description} canonicalPath={canonicalPath} noindex={noindex}>
  <slot name="head" slot="head" />
  <header class="app-header">
    <div class="app-column app-header__inner">
      <a href="/" class="app-header__name">
        {heading}
      </a>
      <div class="app-header__actions">
        <slot name="actions" />
      </div>
    </div>
  </header>
  <main id="main" class="app-column app-main">
    <slot />
  </main>
  <BottomNav active={active} />
</Base>
