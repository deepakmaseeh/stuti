---
import Base from '../layouts/Base.astro';
import BottomNav from './BottomNav.astro';
import TopBar from './TopBar.astro';
import Finder from './islands/Finder';
import SetPanel from './islands/SetPanel';
import SettingsSheet from './islands/SettingsSheet';
import KeyboardShortcuts from './islands/KeyboardShortcuts';
import type { BookChip } from './islands/Keypad';
import { getBooks } from '../lib/content';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  heading?: string;
  active?: 'home' | 'search' | 'set' | 'sets' | 'offline';
  currentSongId?: string;
  hideMobileHeader?: boolean;
  bodyClass?: string;
  hideBottomNav?: boolean;
}
const {
  title,
  description,
  canonicalPath,
  noindex,
  heading = site.name,
  active,
  currentSongId = '',
  hideMobileHeader = false,
  bodyClass,
  hideBottomNav = false,
} = Astro.props;

const books: BookChip[] = (await getBooks()).map((b) => ({
  id: b.id,
  native: b.name.native,
  en: b.name.en,
  lang: b.lang,
  numbering: b.numbering,
}));
---

<Base
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  bodyClass={[bodyClass, hideBottomNav ? 'hide-bottom-nav' : ''].filter(Boolean).join(' ') || undefined}
>
  <slot name="head" slot="head" />
  <TopBar />
  <div class="desktop-shell">
    <aside class="desktop-finder" transition:persist="finder">
      <Finder client:media={`(min-width: ${site.layout.desktopMin}px)`} books={books} currentId={currentSongId} />
    </aside>
    <div class="desktop-main" transition:animate="none">
      {
        !hideMobileHeader && (
          <header class="app-header">
            <div class="app-column app-header__inner">
              <a href="/" class="app-header__name">
                {heading}
              </a>
              <div class="app-header__actions">
                <a
                  class="icon-btn"
                  href="/guide/"
                  data-feature="about"
                  aria-label="About & guide"
                  title="About & guide"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    aria-hidden="true"
                    ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg
                  >
                </a>
                <a
                  class="icon-btn"
                  href="/settings/"
                  data-feature="settings"
                  data-open-settings
                  aria-label="Settings"
                  title="Settings"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    aria-hidden="true"
                    ><path
                      d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
                    ></path><circle cx="12" cy="12" r="3"></circle></svg
                  >
                </a>
                <slot name="actions" />
              </div>
            </div>
          </header>
        )
      }
      <main id="main" class="app-column app-main app-main-inner">
        <slot />
      </main>
    </div>
    <div
      class="desktop-set-drawer-backdrop"
      data-close-drawer
      onclick="this.classList.remove('is-open');document.querySelector('.desktop-set')?.classList.remove('is-open')"
    >
    </div>
    <aside class="desktop-set is-drawer" transition:persist="setpanel">
      <SetPanel client:media={`(min-width: ${site.layout.desktopMin}px)`} currentId={currentSongId} />
    </aside>
  </div>
  {!hideBottomNav && <BottomNav active={active} />}
  <SettingsSheet client:load books={books.map((b) => ({ id: b.id, en: b.en }))} />
  <script is:inline>
    if (!window.__stutiSettingsClickBound) {
      window.__stutiSettingsClickBound = true;
      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest && e.target.closest('[data-open-settings]');
        if (!t) return;
        e.preventDefault();
        window.__stutiOpenSettings = true;
        dispatchEvent(new Event('stuti:open-settings'));
      });
    }
  </script>
  <KeyboardShortcuts client:media={`(min-width: ${site.layout.desktopMin}px)`} />
</Base>
