---
import { t } from '../i18n';

interface Props {
  active?: 'home' | 'search' | 'set' | 'sets' | 'offline';
}
const { active } = Astro.props;
const current = active === 'set' ? 'sets' : active;

const items = [
  {
    key: 'home',
    href: '/',
    label: t('nav.home'),
    icon: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
  },
  {
    key: 'search',
    href: '/search/',
    label: t('nav.search'),
    icon: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14m9.5 16.5-3.5-3.5',
  },
  {
    key: 'sets',
    href: '/sets/',
    label: t('nav.sets'),
    icon: 'M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01',
  },
  { key: 'offline', href: '/downloads/', label: t('nav.offline'), icon: 'M12 3v12m0 0-5-5m5 5 5-5M5 21h14' },
] as const;
---

<nav class="bottom-nav" aria-label="Main">
  {items.map((it) => (
    <a href={it.href} class="bottom-nav__item" aria-current={current === it.key ? 'page' : undefined}>
      <span class="bottom-nav__pill">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={it.icon} />
        </svg>
      </span>
      <span>{it.label}</span>
    </a>
  ))}
</nav>
