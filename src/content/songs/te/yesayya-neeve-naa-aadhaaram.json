      "lines": [
        {
          "n": "యేసయ్యా నీవే నా ఆధారం",
          "r": "Yesayya neeve naa aadhaaram",
          "e": "Jesus, You are my foundation"
        },
        {
          "n": "చీకటిలో నీవే నా వెలుగు",
          "r": "Cheekatilo neeve naa velugu",
          "e": "You are my light in the darkness"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "దారి తెలియని వేళలో",
          "r": "Daari teliyani velalo",
          "e": "In the hour I did not know the way"
        },
        {
          "n": "నా చేయి పట్టావు",
          "r": "Naa cheyi pattaavu",
          "e": "You held my hand"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "ఉదయం సాయంత్రం నిన్నే పాడెదను",
          "r": "Udayam saayantram ninne paadedanu",
          "e": "Morning and evening I will sing of You"
        },
        {
          "n": "నీ ప్రేమలో జీవించెదను",
          "r": "Nee premalo jeevinchedanu",
          "e": "I will live in Your love"
        }
      ]
    }
  ],
