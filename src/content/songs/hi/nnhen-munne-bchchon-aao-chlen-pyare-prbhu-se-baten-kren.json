    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "छोटा प्यारा यीशु कभी न लड़ा,",
          "r": "",
          "e": ""
        },
        {
          "n": "हम भी किसी से कभी न लड़े",
          "r": "",
          "e": ""
        },
        {
          "n": "मिलके चले, मिलके चलें, प्यारे प्रभु से बातें करें",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "कितनी अच्छी चीजें, वह देता हमें,",
          "r": "",
          "e": ""
        },
        {
          "n": "छोटा सा दिल भी उसी को दे दें",
          "r": "",
          "e": ""
        },
        {
          "n": "मिलके चले, मिलके चलें, प्यारे प्रभु से बातें करें",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "प्यार से बुलाता है, यीशु तुम्हें,",
          "r": "",
          "e": ""
        },
        {
          "n": "उछलते और कूदते और गाते चलें",
