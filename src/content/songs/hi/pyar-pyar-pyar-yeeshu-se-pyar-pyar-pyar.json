    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "ला ला ला ला ला",
          "r": "",
          "e": ""
        },
        {
          "n": "प्यार प्यार प्यार प्यार प्यार प्यार प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "प्यार प्यार प्यार यीशु से प्यार प्यार प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "क्या हुआ क्या हुआ, क्या हुआ तुझे क्या हुआ",
          "r": "",
          "e": ""
        },
        {
          "n": "मुझे यीशु से प्यार हो गया",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "चैन मिला सुकून मिला, चैन मिला रे बाबा चैन मिला",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "जब से यीशु मेरा हो गया, मेरा सारा जीवन बदल गया",
          "r": "",
          "e": ""
        },
        {
          "n": "दिल गया मुझको सच्चा दोस्त, जो कभी ना छोड़ेगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "यीशु देखे जो मेरी ओर, नाचू गांव मचाऊं मैं शोर",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "उसे पाने के लिए मैं दौड़ उसकी ओर",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
