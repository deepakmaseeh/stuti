  "title": {
    "native": "दुनिया पे आंख लगी तो… छनि गया तेरा अभिषेक",
    "roman": "",
    "en": ""
  },
  "aliases": [],
  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "दुनिया पे आंख लगी तो… छनि गया तेरा अभिषेक",
          "r": "",
          "e": ""
        },
        {
          "n": "लोगो पर आस लगी तो… हाय गया तेरा आभिषेक",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "तो सम्भाल… तू सम्भाल",
          "r": "",
          "e": ""
        },
        {
          "n": "पाए हुए अभिषेक को तू सम्भाल",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "फंस न जाना अभिमान में…वह गरीबी साथ लायेगा",
          "r": "",
          "e": ""
        },
        {
          "n": "पड न जाना धन के मोह में…",
          "r": "",
          "e": ""
        },
        {
          "n": "तुझको पाताल में ले जायेगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "नाशवान दौलत से… अपने लिए मित्र बना ले",
          "r": "",
          "e": ""
        },
        {
          "n": "जब तू स्चदेश जायेगा… तो स्वागत सम्मान पाएगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "बुलाहट में बने रहो तो… अभिषेक को बचा रखोगे",
          "r": "",
          "e": ""
        },
        {
          "n": "बुलाता जो वफादार है… तुझे हर दिन सम्भालेगा",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
