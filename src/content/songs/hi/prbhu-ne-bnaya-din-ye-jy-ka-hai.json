        {
          "n": "जुय के साथ बढेंगे… प्रभु ने बनाया…",
          "r": "",
          "e": ""
        },
        {
          "n": "तू रहता सदा नाम तेरा प्यारा",
          "r": "",
          "e": ""
        },
        {
          "n": "कहते है हम सदा",
          "r": "",
          "e": ""
