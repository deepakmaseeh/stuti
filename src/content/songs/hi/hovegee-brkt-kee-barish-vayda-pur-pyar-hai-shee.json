  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "होवेगी बरकत की बारिश, वायदा पुर प्यार है सही,",
          "r": "",
          "e": ""
        },
        {
          "n": "बरकत की बारिश, बरकत की बारिश भरपूर,",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "होवेगी बरकत की बारिश, होगी नई कूव्वत ज़रूर,",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "होवेगी बरकत की बारिश, काश अभी पावें हम सब,",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु तू ताज़गी अब बख्श दे, वायदे को पूरा कर अब",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "होवेगी बरकत की बारिश, भेज उसे अभी, हाँ अब,",
          "r": "",
          "e": ""
        },
        {
          "n": "मानते गुनाह जब हम अपने, दे बारिश यीशु ऐ रब्ब",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
