        {
          "n": "यीशु मेरा सहारा है",
          "r": "Yeshu mera sahara hai",
          "e": "Jesus is my support"
        },
        {
          "n": "अंधेरे में उजियारा है",
          "r": "Andhere mein ujiyara hai",
          "e": "He is light in the darkness"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "जब राह न सूझे, वह हाथ थामे",
          "r": "Jab raah na soojhe, voh haath thaame",
          "e": "When I cannot see the way, He holds my hand"
        },
        {
          "n": "हर डर को वह दूर भगाए",
          "r": "Har dar ko voh door bhagaaye",
          "e": "He drives every fear away"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "सुबह-शाम मैं उसके गीत गाऊँ",
          "r": "Subah-shaam main uske geet gaaoon",
          "e": "Morning and evening I sing His songs"
        },
        {
          "n": "उसके प्रेम में जीवन बिताऊँ",
          "r": "Uske prem mein jeevan bitaaoon",
          "e": "I spend my life in His love"
        }
      ]
    }
