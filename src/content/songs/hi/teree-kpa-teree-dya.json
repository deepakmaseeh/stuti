      "label": "Verse 1",
      "lines": [
        {
          "n": "तेरी कॄपा॥ तेरी दया…",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरा अनुग्रह मुझ पर हुआ",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु मेरे॥येशु मेरे॥येशु मेरे॥येशु मेरे॥",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "मैं पापी था॥पापों के राहो में",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "मैं भटका करता था",
          "r": "",
          "e": ""
        },
        {
          "n": "मैने वही किया मेरे येशु जो तेरी नजरों में बुरा था",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरी नजर॥मुझ पर हुई",
          "r": "",
          "e": ""
        },
        {
          "n": "मुझ पापी को तुने किया क्षमा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "येशु मुझे॥ तेरे मिलने से मुझको",
          "r": "",
          "e": ""
        },
        {
          "n": "जीने की चाहत हुई",
          "r": "",
          "e": ""
        },
        {
          "n": "आई खुशियाँ जीवन में मेरे उम्मीद फिर जाग उठी",
          "r": "",
          "e": ""
        },
        {
          "n": "जब से मसीह॥मुझको मिले॥",
          "r": "",
          "e": ""
        },
        {
          "n": "बदल गई मेरी ये जिन्दगी",
          "r": "",
          "e": ""
        }
      ]
    }
