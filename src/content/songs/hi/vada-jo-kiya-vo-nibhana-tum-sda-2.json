  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "वादा जो किया, वो निभाना तुम सदा (2)",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर ने है साथ तुमको दिया (2)",
          "r": "",
          "e": ""
        },
        {
          "n": "वादा जो किया...",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "स्वार्थ ना हो, शर्त ना हो, प्यार ऐसा करो.",
          "r": "",
          "e": ""
        },
        {
          "n": "हर कमी को प्यार से तुम,",
          "r": "",
          "e": ""
        },
        {
          "n": "दिल से पूरा करो.",
          "r": "",
          "e": ""
        },
        {
          "n": "हर खुशी हर गम में भी तुम दोनों साथ रहो।",
          "r": "",
          "e": ""
        },
        {
          "n": "हर कदम पे, बन के ताक़त,",
          "r": "",
          "e": ""
        },
        {
          "n": "साथ चलता रहो।",
          "r": "",
          "e": ""
        },
        {
          "n": "जो गलती हो अगर, माफ़ कर दो उस तरह",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर ने है माफ़ तुमको किया। (2)",
          "r": "",
          "e": ""
        },
        {
          "n": "वादा जो किया...",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "आरज़ो है, घर तुम्हारा,",
          "r": "",
          "e": ""
        },
        {
          "n": "प्यार से ही बने,",
          "r": "",
          "e": ""
        },
        {
          "n": "जिंदगी मैं, अब हमारी",
          "r": "",
          "e": ""
        },
        {
          "n": "खुदा ही पहले रहे.",
          "r": "",
          "e": ""
        },
        {
          "n": "सारे सपने, सारे अरमान, साथ पूरे करो,",
          "r": "",
          "e": ""
        },
        {
          "n": "एक हुए हो, एक रहोगे ये आज वादा करो.",
          "r": "",
          "e": ""
        },
        {
          "n": "करो इतना प्यार तुम, जो कभी ना हो ख़तम, (2)",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर ने है प्यार तुमसे किया। (2)",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "वादा जो किया, वो निभाना तुम सदा (2)",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर ने है साथ मेरा दिया।",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर ने है माफ़ मुझको किया।",
          "r": "",
          "e": ""
        },
        {
          "n": "जिस तरह मेरे परमेश्वर, ने है प्यार हमसे किया।",
          "r": "",
          "e": ""
        }
      ]
    }
