  "aliases": [],
  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "कहता है पैदा हुआ यीशु हमारा",
          "r": "",
          "e": ""
        },
        {
          "n": "ये सुसमाचार है कि प्रभु है आया",
          "r": "",
          "e": ""
        },
        {
          "n": "मनुष्य के रुप में उद्धार लाया",
          "r": "",
          "e": ""
        },
        {
          "n": "बैतलह के गौशाले में........",
          "r": "",
          "e": ""
        },
        {
          "n": "प्रेम जगत को आया बचाने",
          "r": "",
          "e": ""
        },
        {
          "n": "नवजीवन को हमें दिलाने",
          "r": "",
          "e": ""
        },
        {
          "n": "नाम है जीसका यीशु मसीह",
          "r": "",
          "e": ""
        },
        {
          "n": "देता संदेश ज़हां को",
          "r": "",
          "e": ""
        },
        {
          "n": "पूरब दिशा का तारा, चले गड़रिया",
          "r": "",
          "e": ""
        },
        {
          "n": "दण्डवत करने, अपने मुक्तिदाता को",
          "r": "",
          "e": ""
        },
        {
          "n": "बैतलह के गौशाले में........",
          "r": "",
          "e": ""
        },
        {
          "n": "देश – देश के राजा आए",
          "r": "",
          "e": ""
        },
        {
          "n": "सोना मुर्र लोबान चढ़ाएं",
          "r": "",
          "e": ""
        },
        {
          "n": "द्वार खुले हम हृदय लेकर आए",
          "r": "",
          "e": ""
        },
        {
          "n": "हम भी उसके द्वार पर जाएं",
          "r": "",
          "e": ""
        },
        {
          "n": "अपना जीवन भेंट चढ़ाए",
          "r": "",
          "e": ""
        },
        {
          "n": "उसकी जय और सन्ना गाएं",
          "r": "",
          "e": ""
        },
        {
          "n": "सारे जगत का पालनहारा",
          "r": "",
          "e": ""
        },
        {
          "n": "बैतलह के गौशाले में........",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
