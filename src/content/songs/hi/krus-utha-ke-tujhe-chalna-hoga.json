      "label": "Verse 1",
      "lines": [
        {
          "n": "आज प्रभु को दिल देना होगा -2",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "राह तू अपनी छोड़ के आजा,",
          "r": "",
          "e": ""
        },
        {
          "n": "नव-जीवन उपहार में ले जा",
          "r": "",
          "e": ""
        },
        {
          "n": "आज प्रभु के लिये क्रूस उठा जा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "दीप तेरा कभी बुझने न पाए,",
          "r": "",
          "e": ""
        },
        {
          "n": "ज्योत मसीह से नेह लगाए",
          "r": "",
          "e": ""
        },
        {
          "n": "आज प्रभु की ज्योति पार लगाए।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "दूर करेगा गम तेरे दिल का,",
          "r": "",
          "e": ""
        },
        {
          "n": "पाप मिटाके नव-जीवन देगा",
          "r": "",
          "e": ""
        },
        {
          "n": "आज प्रभु के लिए आना होगा।",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
