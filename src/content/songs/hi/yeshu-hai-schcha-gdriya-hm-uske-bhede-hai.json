      "lines": [
        {
          "n": "येशु है सच्चा गडरिया… हम उसके भेडे है",
          "r": "",
          "e": ""
        },
        {
          "n": "हरी चराईयों में… हमे चराता है…",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "वादी पहाडी में ले चलता है",
          "r": "",
          "e": ""
        },
        {
          "n": "जहाँ पर सुखदायी झरने बहते है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "संकट मे मेरी रक्षा वो करता है",
          "r": "",
          "e": ""
        },
        {
          "n": "शैतान के हाथों से हमे छुडाता है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "हमको किसी का अब तो डर नही है",
          "r": "",
          "e": ""
        },
        {
          "n": "क्योंकि ये्रशु जो मेरा साथी है",
          "r": "",
          "e": ""
        }
      ]
    }
