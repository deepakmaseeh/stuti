    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "किससे करू मै तेरी तुलना, कौन है तेरे समान",
          "r": "",
          "e": ""
        },
        {
          "n": "तूफ़ान भी सुनकर तेरी माने, सागर भी हट जाएं।",
          "r": "",
          "e": ""
        }
