      "label": "Verse 1",
      "lines": [
        {
          "n": "कैसे मै तेरी महिमा गाऊं, शब्द भी कम पड़ जाएं",
          "r": "",
          "e": ""
        },
        {
          "n": "लिखने बैठू तेरी बातें, कागज में ना समाएं।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "आश्चर्य तेरे जग में इतने, कैसे मै इनको बयान करू",
          "r": "",
          "e": ""
        },
