    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "टूटकर बिखरने न देगा मुझे यीशु मसीह का प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "जिसने अकेला न छोड़ा मुझे कैसा अनोखा प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "माँ की तरह मुझे थामेगा वो गिरने न देगा मुझे",
          "r": "",
          "e": ""
        },
        {
          "n": "मेरे आँखों के आंसू को पोंछेगा वो बाहों में लेगा मुझे",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "मेरी निर्बलता में मेरी सामर्थ यीशु मसीह का प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "जिसने अकेला न छोड़ा मुझे कैसा अनोखा प्यार",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशुआ आ आ यीशुआ आ आ यीशुआ आ आ",
          "r": "",
          "e": ""
        }
      ]
    }
