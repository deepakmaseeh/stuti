      "lines": [
        {
          "n": "शालोम खुदा की अद्भूत शांती",
          "r": "",
          "e": ""
        },
        {
          "n": "मुझ में आई है",
          "r": "",
          "e": ""
        },
        {
          "n": "शालोम मसीह की अद्भूत शांती",
          "r": "",
          "e": ""
        },
        {
          "n": "मुझ में आई है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "थोडे ही समय की कष्टी यहाँ",
          "r": "",
          "e": ""
        },
        {
          "n": "सारी भलाईयाँ मिलेगी वहाँ",
          "r": "",
          "e": ""
        },
        {
          "n": "जब येशु बादलो पर आयेगा",
          "r": "",
          "e": ""
        },
        {
          "n": "हमको प्रातीफल वही वह देगा … शालोम",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "यहोवा जो मेरे हरदम साथ है",
          "r": "",
          "e": ""
        },
        {
          "n": "कुच भी अनर्थों से मै न डरू",
          "r": "",
          "e": ""
        },
        {
          "n": "हे येशु तुने मुझे छुनलीया",
          "r": "",
          "e": ""
        },
        {
          "n": "हरदम मैं तेरी आराधना करू … शालोम",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "न चाहीये मुझे संसार की क्षान",
          "r": "",
          "e": ""
        },
        {
          "n": "नही यहाँ का वह इज्जत और मान",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु से मिले मुझे स्वीकॄती",
          "r": "",
          "e": ""
        },
        {
          "n": "स्वर्ग के मिले वह आनंद खुशी",
          "r": "",
          "e": ""
        }
      ]
    }
