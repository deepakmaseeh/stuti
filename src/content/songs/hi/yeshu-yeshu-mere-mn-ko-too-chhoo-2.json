      "label": "Verse 2",
      "lines": [
        {
          "n": "ये जमीन तेरी पैंरो की हे जगह",
          "r": "",
          "e": ""
        },
        {
          "n": "और आसमान में हे तेरा हाथ फैला … 2",
          "r": "",
          "e": ""
        },
        {
