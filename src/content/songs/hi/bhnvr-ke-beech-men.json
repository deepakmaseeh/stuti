    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "भंवर के बीच में तू कहता है थम जा, तू मेरी ताकत है तू ही मेरा ईमान।",
          "r": "",
          "e": ""
        },
        {
          "n": "​बीते कल में तू साथ मेरे था, आज भी मेरे साथ है खड़ा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "उठते हुए उफ्फानो में, तू ही मेरी चट्टान,",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "बीमारियों में तू कहता है उठ जा, यहोवा राफा तू ही मेरी शिफा।",
          "r": "",
          "e": ""
        },
        {
          "n": "​बीते कल में तू साथ मेरे था, आज भी मेरे साथ है खड़ा।",
          "r": "",
          "e": ""
        }
      ]
    }
