  "title": {
    "native": "मुक्ति का नायक हैे॥|जय तुझे देता है",
    "roman": "",
    "en": ""
  },
  "aliases": [],
  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "मुक्ति का नायक हैे॥|जय तुझे देता है",
          "r": "",
          "e": ""
        },
        {
          "n": "मुझमे वो जीवित है॥कितना आनंद है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "मैं गाते गाते रहूँगा… रोज नाचते नाचते गाऊँगा…",
          "r": "",
          "e": ""
        },
        {
          "n": "और दौडते दौडते कहुँगा…मेरा येशु जिंदा हुआ है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "वो खोजते खोजते आया…मुझे गले लगाया अपने…",
          "r": "",
          "e": ""
        },
        {
          "n": "मेरे पापों का क्षमा किया…नये सिरेसे मुझे बनाया…",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "वो प्रेम के अभिषेक से… चलाता है हरदम…",
          "r": "",
          "e": ""
        },
        {
          "n": "शैतान को जीतने के ल्एि…अधिकार वो दे दिया है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "लाल समुद्र को पार करके…",
          "r": "",
          "e": ""
        },
        {
          "n": "यरदन को भी पार करूँगा…",
          "r": "",
          "e": ""
        },
        {
          "n": "यरीहो को ज्ीतने के लिए॥",
          "r": "",
          "e": ""
        },
        {
          "n": "मैं तुरही फँुकते रहँुगा",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
