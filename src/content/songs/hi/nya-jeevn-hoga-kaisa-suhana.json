      "label": "Verse 1",
      "lines": [
        {
          "n": "नया जीवन होगा कैसा सुहाना,",
          "r": "",
          "e": ""
        },
        {
          "n": "जहाँ तुम रहोगे.. वहाँ मैं रहूँगा... अनंत जीवन होगा। – 2",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "दुनिया की ये शाम ढल जायेगी, कैसा सुहाना आलौकिक दिन होगा – 2",
          "r": "",
          "e": ""
        },
        {
          "n": "जहाँ तुम रहोगे.. वहाँ मैं रहूँगा... अनंत जीवन होगा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "यीशु महिमा की धूम मचेगी, कैसा निराला ईश्वरीय दिन होगा। -2",
          "r": "",
          "e": ""
        },
        {
          "n": "जहाँ तुम रहोगे.. वहाँ मैं रहूँगा... अनंत जीवन होगा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "हाल्लेलुयाह हाल्लेलुयाह.... कैसा मनोरम आनंदमय दिन होगा। -2",
          "r": "",
          "e": ""
        },
        {
          "n": "जहाँ योहन गाएगा, वहाँ पतरस नाचेगा....अनंत जीवन होगा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "नरसिंघा जब फुका जाएगा, हम सब के सब पल में बदल जायेंगे। -2",
          "r": "",
          "e": ""
        },
        {
          "n": "राजा यीशु आएगा, हम को लेने आएगा...अनन्त जीवन होगा।",
          "r": "",
          "e": ""
        }
      ]
    }
