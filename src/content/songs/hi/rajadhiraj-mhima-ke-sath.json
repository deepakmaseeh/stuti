      "label": "Verse 1",
      "lines": [
        {
          "n": "राजाधिराज, महिमा के साथ",
          "r": "",
          "e": ""
        },
        {
          "n": "आ रहा है मेघों पर होके सवार-2",
          "r": "",
          "e": ""
        },
        {
          "n": "मुसीबत निंदा-दुःखों का सिलसिला,",
          "r": "",
          "e": ""
        },
        {
          "n": "खत्म होने का समय आ गया-2",
          "r": "",
          "e": ""
        },
        {
          "n": "मेरे प्रिय का जलाली चेहरा",
          "r": "",
          "e": ""
        },
        {
          "n": "देखने का अब समय आ गया-2",
          "r": "",
          "e": ""
        },
        {
          "n": "सब दुःखों से परे – अनंत वास में,",
          "r": "",
          "e": ""
        },
        {
          "n": "ले जाने के लिये वो आ रहा है-2",
          "r": "",
          "e": ""
        },
        {
          "n": "अपने प्रिय के साथ, करने सदा का वास",
          "r": "",
          "e": ""
        },
        {
          "n": "हम जाने वाले हैं, रहें हर पल तैयार-2",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
