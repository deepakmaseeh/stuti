    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "स्वीकार हमको किया… और प्यार हमको दिया",
          "r": "",
          "e": ""
        },
        {
          "n": "पापों की दरियाओं से… तूने पार हमको किया",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "हम तो भूले भटके थे… हमें सीधे रास्ते पे लाया",
          "r": "",
          "e": ""
        },
        {
          "n": "सुख चैन चाहा था जो… प्रभु चरणों में हमने पाया",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "सुनके तेरे वचनों को… जीवन सफल हो गया",
          "r": "",
          "e": ""
        },
        {
          "n": "जीना रहा इक तरफ… मरना सरल हो गया",
          "r": "",
          "e": ""
        }
      ]
