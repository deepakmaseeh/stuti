  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "देखो तारा, देखो तारा, देखो पूरब में चमका एक तारा,",
          "r": "",
          "e": ""
        },
        {
          "n": "जन्म है येशु हमारा, हो देखो जन्म है येशु हमारा।",
          "r": "",
          "e": ""
        },
        {
          "n": "पूरब में देखो चमका एक तारा, जन्म है देखो यीशु हमारा।",
          "r": "",
          "e": ""
        },
        {
          "n": "पूरब में देखो चमका एक तारा, जन्म है देखो यीशु हमारा",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो पूरब में, देखो पूरब में, देखो पूरब में, चमका एक तारा,",
          "r": "",
          "e": ""
        },
        {
          "n": "जन्म है येशु हमारा, देखो जन्म है येशु हमारा।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "वो तारा जिसमें मिलती है शांति, वो तारा जिसमें मिलती है चंगाई।,",
          "r": "",
          "e": ""
        },
        {
          "n": "वो तारा देता पापों से मुक्ति, वो तारा जिसे मिलती है शक्ति",
          "r": "",
          "e": ""
        },
        {
          "n": "वो तारा देता पापों से मुक्ति, वो तारा जिसे मिलती है शक्ति",
          "r": "",
          "e": ""
        },
        {
          "n": "वही तारा, वही तारा, वही तारा है येशु हमारा है, सबका वो पालनहारा,",
          "r": "",
          "e": ""
        },
        {
          "n": "हो देखो सबका वो पालनहार,",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "मिलने को देखो ज्ञानी है आये, साथ वो अपने भेंट भी लाये",
          "r": "",
          "e": ""
        },
        {
          "n": "सोना, लोबान, सोना, लोबान,",
          "r": "",
          "e": ""
        },
        {
          "n": "सोना, लोबान गंधरास वो लाये, येशु का दर्शन वो पाये,",
          "r": "",
          "e": ""
        },
        {
          "n": "हो देखो येशु का दर्शन वो पाये।",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
