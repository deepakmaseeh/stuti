    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "चरणों मे तुने जनम लिया येशु",
          "r": "",
          "e": ""
        },
        {
          "n": "सूलीपे किया विश्राम",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "येशु दया का गहरा सागर",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु है दाता महान",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "हम पर भी येशु कॄपा करना",
          "r": "",
          "e": ""
        },
        {
          "n": "हम है पापी निहार",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "हम सबके पापों को मिटाने",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु हुआ बलिदान",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 6",
      "lines": [
        {
          "n": "क्रुस पर अपना खून बहाया",
          "r": "",
          "e": ""
        },
        {
          "n": "सारा चुकाया दाम",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 7",
      "lines": [
        {
          "n": "क्रूस पर ही येशु विजयी हुआ है",
          "r": "",
          "e": ""
        },
        {
          "n": "देने को अनंत जीवदान",
          "r": "",
          "e": ""
        }
      ]
