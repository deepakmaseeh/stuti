          "r": "",
          "e": ""
        },
        {
          "n": "शैतानों के तूफ़ानों से, हम नहीं डरते-2",
          "r": "",
          "e": ""
        },
        {
          "n": "क्योंकि जिंदा खुदा है हमारा..................",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरे गम को बढ़ा देंगे, वो तुझे न शिफा देंगे",
          "r": "",
          "e": ""
        },
        {
          "n": "वो किसी को क्या देंगे",
          "r": "",
          "e": ""
        },
        {
          "n": "इसलिए दर गैरों के, हम नहीं जाते-2",
          "r": "",
          "e": ""
        },
        {
          "n": "क्योंकि जिंदा खुदा है हमारा..................",
          "r": "",
          "e": ""
        },
        {
          "n": "जब सिताइश होती है, रूह कि बारिश होती है-2",
