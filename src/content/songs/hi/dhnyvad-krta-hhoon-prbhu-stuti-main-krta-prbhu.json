    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "शरणश्थान गढ, है मेरा धन्य राजा",
          "r": "",
          "e": ""
        },
        {
          "n": "आराम शन्ति दता…धन्य राजा…धन्य …यीशु राजा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "संकट में रक्षा की धन्य राजा",
          "r": "",
          "e": ""
        },
        {
          "n": "चमत्कार किया है…धन्य राजा…धन्य …यीशु राजा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "मुझको उठाया है… धन्य राजा",
          "r": "",
          "e": ""
        },
        {
          "n": "चंगा किया है… धन्य राजा… धन्य … यीशु राजा",
          "r": "",
          "e": ""
