    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "अब तक संभाला… धन्य राजा",
          "r": "",
          "e": ""
        },
        {
          "n": "नया दिन दिखाया धन्य राजा…धन्य …यीशु राजा",
          "r": "",
          "e": ""
