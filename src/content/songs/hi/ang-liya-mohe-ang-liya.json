  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "रंग लिया मोहे रंग लियामोहे अपने लहू में रंग लियायीशु ने दिया अपना मस्सा, दिया अपना जहन मुझे अपना रूप दियादिया जीने को रंग, रूहे पाक किया संग चौपान बनाओ,इक अजब खुशी इक अनोखा मज़ा,",
          "r": "",
          "e": ""
        },
        {
          "n": "दिलो जान बनाओसंग लिया मोहे संग लियावो ही प्यार का रूप, चाहे छाओं या धूप यीशु है खुदा,वो ही देता है फल उसमे नहीं छल,",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु है वफामांग लिया मोहे मांग लिया (येशु ने)अब जीना मसीह और मरना नफ़ाजपता हूँ यही,यीशु के बिना जीना क्या जीना,केहता हूँ यही",
          "r": "",
          "e": ""
        },
        {
          "n": "अंग लिया मोहे अंग लिया",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "चलो चलो मसीहा बुलाता है",
          "r": "",
          "e": ""
        },
        {
          "n": "आओ चलो मसीहा बुलाता है",
          "r": "",
          "e": ""
        },
        {
          "n": "वो जो हारे हैं, वो जो टूटे हैं",
          "r": "",
          "e": ""
        },
        {
          "n": "वो जो कुचले दीन दुखियारे",
          "r": "",
          "e": ""
        },
        {
          "n": "सबको है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "आओ चलो प्रयोग करो चाखो",
          "r": "",
          "e": ""
        },
        {
          "n": "चाखो चाखो, आओ पीओ",
          "r": "",
          "e": ""
        },
        {
          "n": "पियो पियो, वो जिंदगी का पानी है",
          "r": "",
          "e": ""
        },
        {
          "n": "आओ पियो वो जिंदगी का पानी है",
          "r": "",
          "e": ""
        },
        {
          "n": "वो जो प्यासा है, हां जो प्यासा है",
          "r": "",
          "e": ""
        },
        {
          "n": "जो जो पिएगा वो प्यासा ना रहेगा",
          "r": "",
          "e": ""
        },
        {
          "n": "वो जिंदगी का पानी है",
          "r": "",
          "e": ""
        },
        {
          "n": "आओ पियो आओ पियो",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "देखो देखो देखो देखो",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो देखो वो जीवन की ज्योति है",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो देखो वो दुनिया की रोशनी है",
          "r": "",
          "e": ""
        },
        {
          "n": "यूज़ जाने जो यूज़ मने जो",
          "r": "",
          "e": ""
        },
        {
          "n": "कभी चले ना वो अंधियारे में",
          "r": "",
          "e": ""
        },
        {
          "n": "जीवन की ज्योति",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो देखो वो जीवन की ज्योति है,",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो देखो देखो देखो",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "सुनो सुनो मसीहा की आवाज सुनो",
          "r": "",
          "e": ""
        },
        {
          "n": "सारे सुनो जी येसु की आवाज सुनो",
          "r": "",
          "e": ""
        },
        {
          "n": "वो है चरवाहा, अच्छा चरवाहा",
          "r": "",
          "e": ""
        },
        {
          "n": "हरि हरि चरागाहों में बितता",
          "r": "",
          "e": ""
        },
        {
          "n": "उसकी आवाज सुनो",
          "r": "",
          "e": ""
        },
        {
          "n": "सुनो सुनो मसीहा की आवाज सुनो, सुनो सुनो",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 6",
      "lines": [
