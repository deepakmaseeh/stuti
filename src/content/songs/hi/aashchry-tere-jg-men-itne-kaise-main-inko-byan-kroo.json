      "label": "Verse 1",
      "lines": [
        {
          "n": "आश्चर्य तेरे जग में इतने, कैसे मैं इनको बयान करू",
          "r": "",
          "e": ""
        },
        {
          "n": "कैसे मैं तेरी महिमा गाऊं, शब्द भी कम पड़ जाएं",
          "r": "",
          "e": ""
        },
        {
          "n": "लिखने बैठू तेरी बातें, कागज में ना समाएं।-2",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "आश्चर्य तेरे जग में इतने, कैसे मैं इनको बयान करू-2 C D C D G",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरी प्रशंसा करू, तेरी प्रशंसा करू",
          "r": "",
          "e": ""
        },
        {
          "n": "धन्यवाद कहूं- धन्यवाद कहूं।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "किससे करू मैं तेरी तुलना, कौन है तेरे समान",
          "r": "",
          "e": ""
        },
        {
          "n": "तूफान भी सुनकर तेरी मानें, सागर भी हट जाएं।",
          "r": "",
          "e": ""
        }
      ]
    }
