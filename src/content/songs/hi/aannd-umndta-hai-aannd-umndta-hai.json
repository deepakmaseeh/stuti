      "lines": [
        {
          "n": "आनंद उमंडता है… आनंद उमंडता है",
          "r": "",
          "e": ""
        },
        {
          "n": "आनंद उमंडता है… हाल्लेलुयाह",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु ने मुझे बचाया",
          "r": "",
          "e": ""
        },
        {
          "n": "पापों को धोया",
          "r": "",
          "e": ""
        },
        {
          "n": "आनंद उमंडताह है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "राह छोडकर मै चल पडा… पापों के राहो में मै चला",
          "r": "",
          "e": ""
        },
        {
          "n": "फिर भी उसने संभाला… मुझे आके बचाया…",
          "r": "",
          "e": ""
        },
        {
          "n": "इतना अच्छा येशु मेरा हो गया",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "पापों में रहनेवाला… दो जग में चलनेवाला…",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु के पास तुम आओ…मुक्ति को अपनाओ…",
          "r": "",
          "e": ""
        },
        {
          "n": "उद्धार करता है… अपना प्यारा है",
          "r": "",
          "e": ""
        }
      ]
    }
