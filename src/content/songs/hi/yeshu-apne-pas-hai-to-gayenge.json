      "lines": [
        {
          "n": "येशु अपने पास है तो… गायेंगे…",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु के जय के नारे॥ लगायेंगे॥",
          "r": "",
          "e": ""
        }
      ]
    },
    {
