  "title": {
    "native": "मेरा यीशु मसीह जब दुनिया में था",
    "roman": "",
    "en": ""
  },
  "aliases": [],
  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "मेरा यीशु मसीह जब दुनिया में था",
          "r": "",
          "e": ""
        },
        {
          "n": "उसने अच्छे अच्छे काम किये",
          "r": "",
          "e": ""
        },
        {
          "n": "कभी भीड को खिलाया… कभी मुर्दो को जिलाया",
          "r": "",
          "e": ""
        },
        {
          "n": "और रोगों को चंगा किया",
          "r": "",
          "e": ""
        },
        {
          "n": "जय जयकार… जय जयकार…",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु के लिये जय जयकार",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "भीड थी पांच हजार… चेले थे बिलकुल लाचार",
          "r": "",
          "e": ""
        },
        {
          "n": "उनको सूझा न कोई उपाय",
          "r": "",
          "e": ""
        },
        {
          "n": "एक लडका वहाँ आया",
          "r": "",
          "e": ""
        },
        {
          "n": "मछली पाँच रोटी लाया",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु ने दिया सबको खिला",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "चारा दिन का बदन… आती उसमें से दुगंध",
          "r": "",
          "e": ""
        },
        {
          "n": "लोगों को ना था कोई विश्वास",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु ने पुकारा",
          "r": "",
          "e": ""
        },
        {
          "n": "लाजार बाहर निकल आ",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु ने दिया लाजार को जिला",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
