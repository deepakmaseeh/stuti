  "sections": [
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "बैतलहम के गौशाले में, जीवन का उजियाला है,",
          "r": "",
          "e": ""
        },
        {
          "n": "यहाँ स्वयं आकाश उतर कर, इस धरती पर आया है ।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "नभ में होती उसकी महिमा,",
          "r": "",
          "e": ""
        },
        {
          "n": "दूतों की वाणी में गौरव,",
          "r": "",
          "e": ""
        },
        {
          "n": "गाती हैं सागर की लहरें,",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु जग में आया है ।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "खोज रहा संसार जिस था,",
          "r": "",
          "e": ""
        },
        {
          "n": "युग युग का संताप लिये",
          "r": "",
          "e": ""
        },
        {
          "n": "नव-जीवन की आशा बन कर,",
          "r": "",
          "e": ""
        },
        {
          "n": "जग का तारक आया है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "क्यों होते मायूस ओ साथी,",
          "r": "",
          "e": ""
        },
        {
          "n": "देख जगत का अन्धियारा",
          "r": "",
          "e": ""
        },
        {
          "n": "दुख -चिता सब दूर करेगा",
          "r": "",
          "e": ""
        },
        {
          "n": "जो मरियम का जाया है ।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "गाओं मिलकर यीशु की जय,",
          "r": "",
          "e": ""
        },
        {
          "n": "जय-जय यीशु मसीह की",
          "r": "",
          "e": ""
        },
        {
          "n": "जो पापों से मुक्ति देने,",
          "r": "",
          "e": ""
        },
        {
          "n": "जग में जन्म ले आया है ।",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
