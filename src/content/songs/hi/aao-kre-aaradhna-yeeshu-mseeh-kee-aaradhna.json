      "label": "Verse 1",
      "lines": [
        {
          "n": "आओ करे आराधना यीशु मसीह की आराधना",
          "r": "",
          "e": ""
        },
        {
          "n": "जो है मेरा खुदा वो है सबका खुदा",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "हालेलुया, हालेलुया हालेलुया, हालेलुया",
          "r": "",
          "e": "",
          "x": 2
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "सृष्टि को रचने वाला वोही हम सबका रखवाला वोही",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "उसकी महिमा करे, उसकी महिमा करे",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "हालेलुया, हालेलुया हालेलुया, हालेलुया",
          "r": "",
          "e": "",
          "x": 2
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "उसके लहू से मिलती शिफा, पापों से सबको मिलती क्षमा",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "मिलता है जीवन नया",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "हालेलुया, हालेलुया हालेलुया, हालेलुया",
          "r": "",
          "e": "",
          "x": 2
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "चाहे जमीन हो या असमान, कोइ नहीं उसके समान",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "वो है ज़िंदा ख़ुदा, वो है ज़िंदा ख़ुदा",
          "r": "",
          "e": "",
          "x": 2
        },
        {
          "n": "हालेलुया, हालेलुया हालेलुया, हालेलुया",
          "r": "",
          "e": "",
          "x": 2
        }
      ]
    }
