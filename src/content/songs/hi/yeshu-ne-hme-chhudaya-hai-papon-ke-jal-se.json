        {
          "n": "येशु ने हमे छुडाया है… पापों के जाल से",
          "r": "",
          "e": ""
        },
        {
          "n": "येशु ने हमे बचाया है… शैतान के चाल से",
          "r": "",
          "e": ""
        },
        {
          "n": "तो गाओ हालेलुयाह",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "हमने शांति पाई है… येशु के नाम से…",
          "r": "",
          "e": ""
        },
        {
          "n": "हमने पाई है क्षमा… मुक्ति श्राप से",
          "r": "",
          "e": ""
        },
        {
          "n": "अब हम ना डरेंगे… येशु जो साथ है",
          "r": "",
          "e": ""
        },
        {
          "n": "शैतान से हम लढेंगे… येशु के नाम से",
          "r": "",
          "e": ""
        },
        {
          "n": "शालोम शांति और सलाम… लाये है आपके नाम",
          "r": "",
          "e": ""
        },
        {
          "n": "शालोम शांति और सलाम… ये है येशु का पे नाम",
          "r": "",
          "e": ""
        }
      ]
    }
