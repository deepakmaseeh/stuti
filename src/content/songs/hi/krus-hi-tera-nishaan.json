      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "क्रूस ही तेरा निशान",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "क्रूस ही तेरा निशान",
          "r": "",
          "e": ""
        },
        {
          "n": "आगे बढ़-ऐ-जवान!",
          "r": "",
          "e": ""
        },
        {
          "n": "पीछे न हटना कभी,",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु है तेरी चट्टान।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "नैय्या तेरी मझधार में डूबी,",
          "r": "",
          "e": ""
        },
        {
          "n": "कौन लगाएगा पार?",
          "r": "",
          "e": ""
        },
        {
          "n": "केवल यीशु हो सकता है,",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरी नैय्या का पतवार।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "तेरे ही खातिर आया जगत में,",
          "r": "",
          "e": ""
        },
        {
          "n": "तुझको बचाने को,",
          "r": "",
          "e": ""
        },
        {
          "n": "तेरे लिए ही यीशु ने खोला,",
          "r": "",
          "e": ""
        },
        {
          "n": "मुक्ति के द्वार को।",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "सबके लिए है सुसंदेशा,",
          "r": "",
          "e": ""
        },
        {
          "n": "उसके ही प्यार का,",
          "r": "",
          "e": ""
        },
        {
          "n": "सबके दिलों का प्यारा मसीह है,",
          "r": "",
          "e": ""
        },
        {
          "n": "राजा है शांति का।",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
