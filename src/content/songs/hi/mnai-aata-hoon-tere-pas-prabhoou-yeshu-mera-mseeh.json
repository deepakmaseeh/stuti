  "title": {
    "native": "मंै आता हूँ तेरे पास… प्राभूु येशु मेरा मसीह",
    "roman": "",
    "en": ""
  },
  "aliases": [],
  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "मंै आता हूँ तेरे पास… प्राभूु येशु मेरा मसीह…",
          "r": "",
          "e": ""
        },
        {
          "n": "मेरे पापों के लिए ही… उद्धार दे दे मसीह…",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "स्वर्ग छोडकर जमीन पर आया…उद्धार देने मसीह…",
          "r": "",
          "e": ""
        },
        {
          "n": "चरणों में तेरे मै आता…तुझको दिल मै देता मसीह",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "मुझे पापों से छुडाने… लहू क्रुसपर बहा दिया…",
          "r": "",
          "e": ""
        },
        {
          "n": "कितना गहरा प्यार किया है…",
          "r": "",
          "e": ""
        },
        {
          "n": "मै भुला न सकूँगा मसीह… मैं आता हूँ",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "स्वीकार कर प्रभु मुझे… अपने राज्य में ले ले…",
          "r": "",
          "e": ""
        },
        {
          "n": "आ जा तू मेरी जीवन में…",
          "r": "",
          "e": ""
        },
        {
          "n": "मेरी जिंदगी तेरी मसीह… मैं आता हूँ",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
