  "sections": [
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "अद्भुत है… 4 यीशु अद्भुत है…",
          "r": "",
          "e": ""
        },
        {
          "n": "सारी दुनिया उसकी रचना",
          "r": "",
          "e": ""
        },
        {
          "n": "मानव जाति उसकी रचना… यीशु अद्भुत है… 2",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "आँधी आये… तुफान आये या",
          "r": "",
          "e": ""
        },
        {
          "n": "आये गम के बादल… यीशु अद्भुत है",
          "r": "",
          "e": ""
        },
        {
          "n": "डरना नही गिरना नही क्योंकि प्राुभु",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु तेरा साथ है",
          "r": "",
          "e": ""
        },
        {
          "n": "आओ आओ यीशु के पास",
          "r": "",
          "e": ""
        },
        {
          "n": "प्यार करेंगा वो तुम से",
          "r": "",
          "e": ""
        },
        {
          "n": "ऐसा प्यार ऐसा खुशी कभी नही मिला",
          "r": "",
          "e": ""
        },
        {
          "n": "कितना अद्भुत है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "कॄस पर ठोका गया… बेगुन्हा उस्को",
          "r": "",
          "e": ""
        },
        {
          "n": "मारा कुछ ना वो कहा",
          "r": "",
          "e": ""
        },
        {
          "n": "सबने कहा मारो इसको फिर भी कहा",
          "r": "",
          "e": ""
        },
        {
          "n": "क्षमा करो कैसा प्यार किया",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु ने खून बहाया है",
          "r": "",
          "e": ""
        },
        {
          "n": "शैतान का खुल्लम खुल्ला तमाशा",
          "r": "",
          "e": ""
        },
        {
          "n": "किया हैं कितना अद्भुत है",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "आयेगा हम को लेने… आयेगा तुम को लेने…",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु बादलों पर",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 5",
      "lines": [
        {
          "n": "देखेगी दुनिया और कहेगी देखो ये है",
          "r": "",
          "e": ""
        },
        {
          "n": "सच्चा परमेश्वर",
          "r": "",
          "e": ""
        },
        {
          "n": "राजाओं का राजा वो है प्रभुओं का प्रभु",
          "r": "",
          "e": ""
        },
        {
          "n": "चारो तरफ होगा शोर लोग कहेंगे",
          "r": "",
          "e": ""
        },
        {
          "n": "देखो यीशु आय धरती पर",
          "r": "",
          "e": ""
        }
      ]
    }
  ],
