      "lines": [
        {
          "n": "हालेलुयाह, हालेलुयाह, हालेलुयाह, हालेलुयाह",
          "r": "",
          "e": ""
        },
        {
          "n": "सीने से लगाएगा, चिन्ता सब मिटाएगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "जैसे माता सम्भालती है, वैसे यीशु सम्भालेगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "हाथ पकड़ के चलाएगा, चट्टान पर चढ़ाएगा",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 3",
      "lines": [
        {
          "n": "मेरे कारण घायल हुआ, मेरे पापों को उठा लिया",
          "r": "",
          "e": ""
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 4",
      "lines": [
        {
          "n": "कभी भी ना छोड़ेगा, कभी भी ना त्यागेगा",
          "r": "",
          "e": ""
        }
      ]
    }
