      "label": "Verse 1",
      "lines": [
        {
          "n": "तो जीवन में सब कुछ मिला",
          "r": "",
          "e": ""
        },
        {
          "n": "भटक रहा था मैं, अंधेरी राह पर",
          "r": "",
          "e": ""
        },
        {
          "n": "तन्हा अकेला, जाता किधर ?",
          "r": "",
          "e": ""
        },
        {
          "n": "खोजते मुझको, यीशु चला आया",
          "r": "",
          "e": ""
        },
        {
          "n": "और जीवन में, सब कुछ मिला",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु मिल गया.........",
          "r": "",
          "e": ""
        },
        {
          "n": "सूली पे ले लिया, पापों को मेरे",
          "r": "",
          "e": ""
        },
        {
          "n": "जान दे दी बदले, जान के मेरे",
          "r": "",
          "e": ""
        },
        {
          "n": "तोड़े सारे बंधन, आजाद है किया",
          "r": "",
          "e": ""
        },
        {
          "n": "और जीने का, मकसद मिला",
          "r": "",
          "e": ""
        },
        {
          "n": "यीशु मिल गया.........",
          "r": "",
          "e": ""
        }
      ]
    }
