      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "இயேசுவே என் துணை நீரே",
          "r": "Yesuve en thunai neere",
          "e": "Jesus, You are my companion"
        },
        {
          "n": "இருளில் என் ஒளி நீரே",
          "r": "Irulil en oli neere",
          "e": "You are my light in the darkness"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "வழி தெரியாத நேரத்தில்",
          "r": "Vazhi theriyaadha nerathil",
          "e": "In the hour I could not see the way"
        },
        {
          "n": "என் கரம் பிடித்தீரே",
          "r": "En karam piditheere",
          "e": "You held my hand"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "காலையும் மாலையும் உம்மைப் பாடுவேன்",
          "r": "Kaalaiyum maalaiyum ummai paaduven",
          "e": "Morning and evening I will sing of You"
        },
        {
          "n": "உம் அன்பில் வாழுவேன்",
          "r": "Um anbil vaazhuven",
          "e": "I will live in Your love"
        }
      ]
    }
  ],
