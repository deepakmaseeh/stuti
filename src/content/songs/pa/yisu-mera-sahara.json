    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "n": "ਯਿਸੂ ਮੇਰਾ ਸਹਾਰਾ ਹੈ",
          "r": "Yisu mera sahara hai",
          "e": "Jesus is my support"
        },
        {
          "n": "ਹਨੇਰੇ ਵਿੱਚ ਚਾਨਣ ਹੈ",
          "r": "Hanere vich chanan hai",
          "e": "He is light in the darkness"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "n": "ਜਦ ਰਾਹ ਨਾ ਲੱਭੇ, ਉਹ ਹੱਥ ਫੜੇ",
          "r": "Jad raah na labbhe, oh hath phade",
          "e": "When I can't find the way, He holds my hand"
        },
        {
          "n": "ਹਰ ਡਰ ਨੂੰ ਦੂਰ ਕਰੇ",
          "r": "Har dar nu door kare",
          "e": "He removes every fear"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "n": "ਸਵੇਰੇ ਸ਼ਾਮ ਮੈਂ ਉਸਦੇ ਗੀਤ ਗਾਵਾਂ",
          "r": "Savere shaam main usde geet gaavan",
          "e": "Morning and evening I sing His songs"
        },
        {
          "n": "ਉਸਦੇ ਪਿਆਰ ਵਿੱਚ ਜੀਵਨ ਬਿਤਾਵਾਂ",
          "r": "Usde pyaar vich jeevan bitaavan",
          "e": "I spend my life in His love"
        }
      ]
    }
  ],
