# Copy to .env for local runs. Remove PUBLIC_INCLUDE_DEMO at real launch (STUTI_FIXES_AND_LAUNCH.md §3.7).
PUBLIC_INCLUDE_DEMO=true
# Google Form prefill base URL for "Report a mistake" (STUTI_FIXES_AND_LAUNCH.md §3.4)
PUBLIC_REPORT_FORM_URL=
# Cloudflare Web Analytics token (optional, leave empty for no analytics)
PUBLIC_CF_ANALYTICS_TOKEN=
