# Copy to .env for local runs.
# PUBLIC_INCLUDE_DEMO is off for the real TLBC catalog (do not set true in production).
# PUBLIC_INCLUDE_DEMO=false
# Optional legacy client prefill (not used for Send — Worker posts to formResponse).
PUBLIC_REPORT_FORM_URL=
# Worker secrets (set via wrangler, not committed):
# GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/XXXX/formResponse
# GOOGLE_FORM_ENTRIES={"id":"entry.…","title":"entry.…",...}
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit
# GITHUB_TOKEN=ghp_…   (contents:write on deepakmaseeh/stuti — Admin Publish)
# ADMIN_EMAILS=godisourlord8874@gmail.com
# Cloudflare Web Analytics token (optional, leave empty for no analytics)
PUBLIC_CF_ANALYTICS_TOKEN=
